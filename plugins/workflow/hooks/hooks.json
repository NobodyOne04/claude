{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__.*merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/guard-main.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/marketplace-branch.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
